<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="moekoemusic-lite.exe"
        Arguments=""
        InstallLocation="C:\Program Files\MoeKoe Music Lite">
    </Installer>
    <PackageInformation
        PackageName="MoeKoe Music Lite"
        PackageDisplayName="MoeKoe Music Lite"
        PublisherName="CN=MoeKoe Music"
        PublisherDisplayName="MoeKoe Music"
        Version="0.1.0.0"
        PackageDescription="MoeKoeLite 萌音极速版">
        <Capabilities>
            <Capability Name="runFullTrust" />

        </Capabilities>
        <Applications>
            <Application
                Id="cn.latedream.moekoemusic-lite"
                Description="MoeKoeLite 萌音极速版"
                DisplayName="MoeKoe Music Lite"
                ExecutableName="moekoemusic-lite.exe"
                EntryPoint="Windows.FullTrustApplication">

            </Application>
        </Applications>
        <Resources>
            <Resource Language="zh-cn" />
            <Resource Language="zh-tw" />
            <Resource Language="en" />
            <Resource Language="ja" />
            <Resource Language="ko" />
            <Resource Language="ru" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>MoeKoe Music Lite</DisplayName>
            <PublisherDisplayName>MoeKoe Music</PublisherDisplayName>
            <Description>MoeKoeLite 萌音极速版</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="moekoemusic-lite.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
